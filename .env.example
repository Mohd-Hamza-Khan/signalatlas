# SignalAtlas Environment Configuration

# Database (use postgresql+asyncpg:// for async support)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/signalatlas

# GitHub
GITHUB_TOKEN=

# OpenRouter (LLM Provider)
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=SignalAtlas
OPENROUTER_APP_VERSION=1.0

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS=

# Optional: Redis (for Phase 2 scaling)
# REDIS_URL=redis://localhost:6379/0
